package skaffy.vista;

import skaffy.shader.*;

public class Post {

    @Uniform float exposure = 1.0;
    @Uniform float bloom = 0.3;
    @Uniform float saturation = 1.1;
    @Uniform float vignette = 0.25;
    @Uniform float occlusion = 1.0;
    @Uniform float fog = 1.0;
    @Uniform float shafts = 1.0;
    @Uniform float sharpen = 0.35;
    @Uniform float smoothing = 0.9;
    @Uniform float glare = 1.0;

    float ambientOcclusion(vec2 uv, Texture normals, float dither) {
        if (isSky(uv) || occlusion <= 0.0) {
            return 1.0;
        }

        vec3 position = relativePos(uv);

        if (length(position) > effectDistance) {
            return 1.0;
        }

        vec3 normal = texture(normals, uv).xyz;

        if (dot(normal, normal) < 0.25) {
            return 1.0;
        }

        normal = normalize(normal);
        float hidden = 0.0;
        const int SAMPLES = 8;

        for (int i = 0; i < SAMPLES; i++) {
            vec3 seed = vec3(uv * screenSize, float(i) * 7.13 + dither * 31.0);
            vec3 direction = normalize(vec3(random(seed), random(seed + 1.7), random(seed + 3.3)) * 2.0 - 1.0 + vec3(0.0001));

            if (dot(direction, normal) < 0.0) {
                direction = -direction;
            }

            float scale = (float(i) + dither) / float(SAMPLES);
            vec3 sample = position + normal * 0.03 + direction * 0.7 * mix(0.15, 1.0, scale * scale);
            vec3 screen = toScreenDepth(sample);

            if (screen.x <= 0.0 || screen.x >= 1.0 || screen.y <= 0.0 || screen.y >= 1.0) {
                continue;
            }

            float scene = texture(DEPTH, screen.xy).r;

            if (scene > screen.z) {
                vec3 hit = depthToRelative(screen.xy, scene);
                hidden += 1.0 - smoothstep(0.6, 1.5, length(position) - length(hit));
            }
        }

        return 1.0 - hidden / float(SAMPLES) * 0.5 * occlusion;
    }

    float smoothOcclusion(Texture raw, vec2 uv) {
        float center = linearDepth(uv);
        vec2 texel = texelSize(raw);
        float sum = 0.0;
        float weight = 0.0;

        for (int x = -2; x < 2; x++) {
            for (int y = -2; y < 2; y++) {
                vec2 at = uv + (vec2(float(x), float(y)) + 0.5) * texel;
                float w = 1.0 / (1.0 + abs(linearDepth(at) - center) * 8.0 / max(center, 0.1));
                sum += texture(raw, at).r * w;
                weight += w;
            }
        }

        return sum / weight;
    }

    vec3 solidWorld(vec2 uv, Texture occluded, Texture clouds, Texture normals, Texture surface, float dither) {
        vec3 color = texture(SCREEN, uv).rgb;

        if (isSky(uv)) {
            color = horizon(uv, color);
        } else {
            color *= texture(occluded, uv).r;
            vec4 info = texture(surface, uv);

            if (info.r > 0.3) {
                vec3 normal = normalize(texture(normals, uv).xyz + vec3(0.0, 0.0001, 0.0));
                vec3 position = relativePos(uv);
                vec3 view = normalize(position);
                vec3 bounce = reflect(view, normal);
                vec4 traced = length(position) < effectDistance ? Rays.trace(SCREEN, DEPTH, position, bounce, dither) : vec4(0.0);
                vec3 skyBounce = Sky.full(normalize(vec3(bounce.x, max(bounce.y, 0.02), bounce.z))) * smoothstep(0.5, 1.0, info.b);
                vec3 mirrored = mix(skyBounce, traced.rgb, traced.a);
                float fresnel = info.g + (1.0 - info.g) * pow(1.0 - max(dot(-view, normal), 0.0), 5.0);
                color = mix(color, mirrored, fresnel * smoothstep(0.3, 0.9, info.r));
            }
        }

        vec4 cloud = texture(clouds, uv);
        return color * cloud.a + cloud.rgb;
    }

    vec3 horizon(vec2 uv, vec3 color) {
        vec3 direction = normalize(relativePos(uv));

        if (dimension != OVERWORLD || direction.y >= 0.0313) {
            return color;
        }

        vec3 sky = Sky.full(direction);
        vec3 cleared = fogColor.rgb;
        return distance(color, cleared) < distance(color, sky) ? sky + max(color - cleared, vec3(0.0)) : color;
    }

    vec3 lightShafts(vec2 uv, float range, float dither) {
        if (dimension != OVERWORLD || shafts <= 0.0) {
            return vec3(0.0);
        }

        vec3 end = relativePos(uv);
        float distance = isSky(uv) ? range : min(length(end), range);
        vec3 direction = normalize(end);
        const int STEPS = 12;
        float stepLength = distance / float(STEPS);
        float t = stepLength * dither;
        vec3 sum = vec3(0.0);

        for (int i = 0; i < STEPS; i++) {
            vec3 position = direction * t;
            vec3 at = shadowPos(position);
            vec3 lit = vec3(1.0);

            if (at.x > 0.0 && at.x < 1.0 && at.y > 0.0 && at.y < 1.0 && at.z < 1.0) {
                bool open = texture(SHADOW_MAP, at.xy).r >= at.z - 0.0003;
                bool openSolid = texture(SHADOW_MAP_SOLID, at.xy).r >= at.z - 0.0003;
                lit = open ? vec3(1.0) : openSolid ? texture(SHADOW_COLOR, at.xy).rgb * 2.0 : vec3(0.0);
            }

            lit *= 1.0 - Clouds.shadow(cameraPosition + position);

            float height = cameraPosition.y + position.y;
            sum += lit * exp(-max(height - 62.0, 0.0) / 50.0);
            t += stepLength;
        }

        float cosine = dot(direction, lightDirection);
        float scatter = Clouds.phase(cosine, 0.75) * 0.6 + 0.06;
        float air = (0.05 + rain * 0.1 + Palette.horizon() * 0.06) * (isInWater ? 3.0 : 1.0);
        return sum / float(STEPS) * Palette.directLight() * scatter * air * shafts * min(distance / 48.0, 1.0);
    }

    vec3 atmosphere(vec2 uv, vec3 color, vec3 rays) {
        bool sky = isSky(uv);
        vec3 position = relativePos(uv);
        float distance = sky ? far : length(position);
        vec3 direction = normalize(position);

        if (isInWater) {
            vec3 kept = exp(-distance * vec3(0.14, 0.055, 0.04) * fog);
            vec3 water = Palette.skyAmbient(vec3(0.0, 1.0, 0.0)) * eyeSkyLight * eyeSkyLight * vec3(0.05, 0.2, 0.28) + Palette.caveLight();
            return color * kept + water * (1.0 - kept) + rays * vec3(0.4, 0.8, 1.0);
        }

        if (isInLava || isInPowderSnow) {
            return mix(color, fogColor.rgb, smoothstep(fogStart, fogEnd, distance));
        }

        if (dimension == NETHER) {
            float amount = 1.0 - exp(-distance * 0.011 * fog);
            return mix(color, pow(fogColor.rgb, vec3(1.2)) * 1.3, amount);
        }

        if (dimension == END) {
            float amount = sky ? 0.0 : 1.0 - exp(-distance * 0.004 * fog);
            return mix(color, vec3(0.05, 0.035, 0.08), amount);
        }

        if (!sky) {
            float low = min(cameraPosition.y + position.y, cameraPosition.y);
            float density = (0.00015 * (1.0 + Palette.horizon() * 0.8) + rain * 0.0045 + thunder * 0.002) * fog;
            float amount = 1.0 - exp(-distance * density * exp(-max(low - 62.0, 0.0) / 60.0));
            vec3 haze = Sky.atmosphere(normalize(vec3(direction.x, max(direction.y, 0.0) * 0.5, direction.z)));
            haze = mix(Palette.caveLight() * 4.0, haze, clamp(eyeSkyLight * 1.3, 0.0, 1.0));
            color = mix(color, haze, amount);
            float edge = smoothstep(renderDistance - clamp(renderDistance * 0.1, 4.0, 64.0), renderDistance, length(position.xz));
            color = mix(color, Sky.full(direction), edge);
        }

        if (fogEnd < 96.0) {
            color = mix(color, fogColor.rgb * 0.2, smoothstep(fogStart, fogEnd, distance));
        }

        return color + rays;
    }

    vec3 temporal(vec2 uv, Texture history, Texture surface) {
        vec2 texel = 1.0 / screenSize;
        vec3 current = texture(SCREEN, uv).rgb;
        vec3 low = current;
        vec3 high = current;
        vec3 cross = vec3(0.0);

        for (int x = -1; x <= 1; x++) {
            for (int y = -1; y <= 1; y++) {
                vec3 near = texture(SCREEN, uv + vec2(float(x), float(y)) * texel).rgb;
                low = min(low, near);
                high = max(high, near);

                if (x == 0 != (y == 0)) {
                    cross += near;
                }
            }
        }

        current = max(current + (current - cross * 0.25) * sharpen * 0.5, vec3(0.0));

        if (abs(texture(surface, uv).a * 255.0 - 2.0) < 0.5) {
            return current;
        }

        vec3 world = relativePos(uv) + cameraPosition;
        vec4 clip = previousProjectionMatrix * (previousViewMatrix * vec4(world - previousCameraPosition, 1.0));
        vec2 back = clip.xy / clip.w * 0.5 + 0.5;

        if (clip.w <= 0.0 || back.x < 0.0 || back.x > 1.0 || back.y < 0.0 || back.y > 1.0) {
            return current;
        }

        vec3 old = clamp(texture(history, back).rgb, low, high);
        float moved = length((back - uv) * screenSize);
        return mix(current, old, smoothing * (1.0 - clamp(moved / 60.0, 0.0, 0.4)));
    }

    vec3 bright(vec2 uv) {
        vec3 color = min(down(SCREEN, uv), vec3(60.0));
        float level = luminance(color);
        return color * max(level - 1.1, 0.0) / max(level, 0.0001);
    }

    vec3 down(Texture source, vec2 uv) {
        vec2 t = texelSize(source);
        vec3 a = texture(source, uv + t * vec2(-2.0, 2.0)).rgb;
        vec3 b = texture(source, uv + t * vec2(0.0, 2.0)).rgb;
        vec3 c = texture(source, uv + t * vec2(2.0, 2.0)).rgb;
        vec3 d = texture(source, uv + t * vec2(-2.0, 0.0)).rgb;
        vec3 e = texture(source, uv).rgb;
        vec3 f = texture(source, uv + t * vec2(2.0, 0.0)).rgb;
        vec3 g = texture(source, uv + t * vec2(-2.0, -2.0)).rgb;
        vec3 h = texture(source, uv + t * vec2(0.0, -2.0)).rgb;
        vec3 i = texture(source, uv + t * vec2(2.0, -2.0)).rgb;
        vec3 j = texture(source, uv + t * vec2(-1.0, 1.0)).rgb;
        vec3 k = texture(source, uv + t * vec2(1.0, 1.0)).rgb;
        vec3 l = texture(source, uv + t * vec2(-1.0, -1.0)).rgb;
        vec3 m = texture(source, uv + t * vec2(1.0, -1.0)).rgb;
        return e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
    }

    vec3 up(Texture smaller, Texture same, vec2 uv) {
        vec2 t = texelSize(smaller);
        vec3 sum = texture(smaller, uv).rgb * 4.0;
        sum += (texture(smaller, uv + vec2(t.x, 0.0)).rgb + texture(smaller, uv - vec2(t.x, 0.0)).rgb
                + texture(smaller, uv + vec2(0.0, t.y)).rgb + texture(smaller, uv - vec2(0.0, t.y)).rgb) * 2.0;
        sum += texture(smaller, uv + t).rgb + texture(smaller, uv - t).rgb + texture(smaller, uv + vec2(t.x, -t.y)).rgb + texture(smaller, uv + vec2(-t.x, t.y)).rgb;
        return sum / 16.0 + texture(same, uv).rgb;
    }

    vec4 meter(Texture picture, Texture last) {
        float sum = 0.0;

        for (int x = 0; x < 8; x++) {
            for (int y = 0; y < 8; y++) {
                vec2 at = (vec2(float(x), float(y)) + 0.5) / 8.0;
                sum += log(max(luminance(texture(picture, at).rgb), 0.0001));
            }
        }

        float target = clamp(0.5 / exp(sum / 64.0), 0.6, 2.2);
        float old = texture(last, vec2(0.5)).r;

        if (old <= 0.0) {
            old = target;
        }

        float rate = target > old ? 1.2 : 2.5;
        return vec4(mix(old, target, 1.0 - exp(-frameTime * rate)), 0.0, 0.0, 1.0);
    }

    vec3 sunGlare(vec2 uv, Texture clouds) {
        float facing = dot(cameraDirection, sunDirection);

        if (dimension != OVERWORLD || glare <= 0.0 || facing <= 0.2 || sunDirection.y < -0.05) {
            return vec3(0.0);
        }

        vec2 sun = toScreen(sunDirection * 100.0);
        vec2 aspect = vec2(screenSize.x / screenSize.y, 1.0);
        float visible = 0.0;

        for (int i = 0; i < 8; i++) {
            float angle = float(i) * 0.785398;
            vec2 at = sun + vec2(cos(angle), sin(angle)) * 0.008 / aspect;

            if (at.x > 0.0 && at.x < 1.0 && at.y > 0.0 && at.y < 1.0 && isSky(at)) {
                visible += texture(clouds, at).a;
            }
        }

        float d = length((uv - sun) * aspect);
        float glow = exp(-d * 2.5) * 0.25 + exp(-d * 6.0) * 0.6 + exp(-d * 20.0) * 1.2 + exp(-d * 60.0) * 2.0;
        return Palette.sunColor() * glow * visible / 8.0 * smoothstep(0.2, 0.9, facing) * smoothstep(-0.05, 0.05, sunDirection.y) * (1.0 - rain) * 0.5 * glare;
    }

    vec3 tonemap(vec3 color) {
        return clamp(color * (2.51 * color + 0.03) / (color * (2.43 * color + 0.59) + 0.14), 0.0, 1.0);
    }

    vec3 finish(vec2 uv, vec3 color, vec3 glow, float measured) {
        vec3 exposed = (color + glow * bloom) * measured * exposure * 0.85;
        vec3 mapped = tonemap(exposed);
        float dusk = Palette.horizon() * Palette.day();
        mapped *= mix(vec3(1.0), vec3(1.06, 1.0, 0.92), dusk * 0.6);
        mapped = mix(vec3(luminance(mapped)), mapped, saturation);
        vec2 centered = (uv - 0.5) * vec2(screenSize.x / screenSize.y, 1.0);
        mapped *= 1.0 - smoothstep(0.45, 1.2, length(centered)) * vignette;
        mapped += (random(uv * screenSize + float(frameCounter % 64)) - 0.5) / 255.0;
        return clamp(mapped, 0.0, 1.0);
    }
}
