package skaffy.vista;

import skaffy.shader.*;

public class Surface {
    @Uniform float bumps = 1.0;
    @Uniform float puddles = 1.0;

    @Texture(value = "vista_noise.png", filter = LINEAR) Texture noise;

    @Blocks("#minecraft:leaves") const int LEAVES = 1;
    @Blocks({"minecraft:short_grass", "minecraft:fern", "minecraft:short_dry_grass", "minecraft:bush", "minecraft:firefly_bush", "minecraft:dead_bush",
            "minecraft:sweet_berry_bush", "minecraft:seagrass", "#minecraft:small_flowers", "#minecraft:crops", "#minecraft:saplings"}) const int PLANTS = 2;
    @Blocks("minecraft:water") const int WATER = 3;
    @Blocks("minecraft:lava") const int LAVA = 4;
    @Blocks({"#minecraft:impermeable", "minecraft:glass_pane", "minecraft:white_stained_glass_pane", "minecraft:orange_stained_glass_pane",
            "minecraft:magenta_stained_glass_pane", "minecraft:light_blue_stained_glass_pane", "minecraft:yellow_stained_glass_pane",
            "minecraft:lime_stained_glass_pane", "minecraft:pink_stained_glass_pane", "minecraft:gray_stained_glass_pane",
            "minecraft:light_gray_stained_glass_pane", "minecraft:cyan_stained_glass_pane", "minecraft:purple_stained_glass_pane",
            "minecraft:blue_stained_glass_pane", "minecraft:brown_stained_glass_pane", "minecraft:green_stained_glass_pane",
            "minecraft:red_stained_glass_pane", "minecraft:black_stained_glass_pane"}) const int GLASS = 5;
    @Blocks({"minecraft:iron_block", "minecraft:gold_block", "minecraft:netherite_block", "minecraft:copper_block", "minecraft:cut_copper",
            "minecraft:waxed_copper_block", "minecraft:waxed_cut_copper", "minecraft:iron_bars", "minecraft:iron_door", "minecraft:iron_trapdoor",
            "minecraft:anvil", "minecraft:chipped_anvil", "minecraft:damaged_anvil", "minecraft:cauldron", "minecraft:hopper",
            "minecraft:heavy_weighted_pressure_plate", "minecraft:light_weighted_pressure_plate"}) const int METAL = 6;
    @Blocks({"minecraft:polished_andesite", "minecraft:polished_diorite", "minecraft:polished_granite", "minecraft:polished_deepslate",
            "minecraft:polished_blackstone", "minecraft:polished_tuff", "minecraft:quartz_block", "minecraft:smooth_quartz",
            "minecraft:quartz_pillar", "minecraft:chiseled_quartz_block", "minecraft:smooth_stone", "minecraft:obsidian"}) const int POLISHED = 7;
    @Blocks({"#minecraft:diamond_ores", "#minecraft:emerald_ores", "#minecraft:gold_ores", "#minecraft:iron_ores", "#minecraft:copper_ores",
            "#minecraft:lapis_ores", "#minecraft:redstone_ores", "#minecraft:coal_ores", "minecraft:nether_quartz_ore", "minecraft:nether_gold_ore",
            "minecraft:ancient_debris", "minecraft:diamond_block", "minecraft:emerald_block", "minecraft:lapis_block",
            "minecraft:amethyst_block"}) const int ORE = 8;
    @Blocks({"minecraft:ice", "minecraft:packed_ice", "minecraft:blue_ice", "minecraft:frosted_ice"}) const int ICE = 9;
    @Blocks({"minecraft:snow", "minecraft:snow_block", "minecraft:powder_snow"}) const int SNOW = 10;
    @Blocks({"minecraft:glowstone", "minecraft:sea_lantern", "minecraft:shroomlight", "minecraft:ochre_froglight", "minecraft:verdant_froglight",
            "minecraft:pearlescent_froglight", "minecraft:redstone_lamp", "minecraft:jack_o_lantern", "minecraft:torch",
            "minecraft:wall_torch", "minecraft:soul_torch", "minecraft:soul_wall_torch", "minecraft:redstone_torch", "minecraft:redstone_wall_torch",
            "minecraft:copper_torch", "minecraft:copper_wall_torch", "minecraft:lantern", "minecraft:soul_lantern", "minecraft:copper_lantern",
            "minecraft:exposed_copper_lantern", "minecraft:weathered_copper_lantern", "minecraft:oxidized_copper_lantern", "minecraft:waxed_copper_lantern",
            "minecraft:waxed_exposed_copper_lantern", "minecraft:waxed_weathered_copper_lantern", "minecraft:waxed_oxidized_copper_lantern",
            "minecraft:copper_bulb[lit=true]", "minecraft:exposed_copper_bulb[lit=true]", "minecraft:weathered_copper_bulb[lit=true]",
            "minecraft:oxidized_copper_bulb[lit=true]", "minecraft:waxed_copper_bulb[lit=true]", "minecraft:waxed_exposed_copper_bulb[lit=true]",
            "minecraft:waxed_weathered_copper_bulb[lit=true]", "minecraft:waxed_oxidized_copper_bulb[lit=true]",
            "minecraft:campfire", "minecraft:soul_campfire", "minecraft:fire", "minecraft:soul_fire", "minecraft:end_rod", "minecraft:beacon",
            "minecraft:crying_obsidian", "minecraft:glow_lichen", "minecraft:sea_pickle", "minecraft:amethyst_cluster", "minecraft:respawn_anchor",
            "minecraft:conduit", "minecraft:nether_portal"}) const int GLOWING = 11;
    @Blocks({"minecraft:vine", "minecraft:cave_vines", "minecraft:cave_vines_plant", "minecraft:weeping_vines", "minecraft:weeping_vines_plant",
            "minecraft:twisting_vines", "minecraft:twisting_vines_plant", "minecraft:hanging_roots", "minecraft:pale_hanging_moss"}) const int VINES = 12;
    @Blocks("minecraft:lily_pad") const int LILY = 13;
    @Blocks({"minecraft:tall_grass", "minecraft:large_fern", "minecraft:tall_dry_grass", "minecraft:sunflower", "minecraft:lilac",
            "minecraft:rose_bush", "minecraft:peony", "minecraft:tall_seagrass", "minecraft:pitcher_plant"}) const int TALL_PLANTS = 14;
    @Blocks("minecraft:redstone_wire") const int REDSTONE_WIRE = 15;
    @Blocks({"minecraft:repeater[powered=true]", "minecraft:comparator[powered=true]"}) const int REDSTONE_LIT = 16;
    @Blocks("minecraft:magma_block") const int MAGMA = 17;
    @Blocks({"minecraft:sculk_sensor", "minecraft:calibrated_sculk_sensor", "minecraft:sculk_catalyst"}) const int SCULK = 18;
    @Blocks({"minecraft:open_eyeblossom", "minecraft:potted_open_eyeblossom", "minecraft:firefly_bush"}) const int EMISSIVE_PARTS = 19;

    record Info(vec3 albedo, vec3 normal, float smoothness, float f0, float sss, float emission, float ao, float sky, float block, float puddle) {}

    vec3 bump(vec2 uv, vec3 position, vec3 normal, float strength) {
        if (strength <= 0.001) {
            return normal;
        }

        vec2 size = vec2(textureSize(SOURCE, 0));
        vec2 texel = 1.0 / size;
        vec2 low = floor(uv * size / 16.0) * 16.0 * texel + texel * 0.5;
        vec2 high = low + texel * 15.0;
        vec2 here = clamp(floor(uv * size) * texel + texel * 0.5, low, high);
        float h = luminance(textureLod(SOURCE, here, 0.0).rgb);
        float hx = luminance(textureLod(SOURCE, clamp(here + vec2(texel.x, 0.0), low, high), 0.0).rgb);
        float hy = luminance(textureLod(SOURCE, clamp(here + vec2(0.0, texel.y), low, high), 0.0).rgb);
        vec3 dp1 = dFdx(position);
        vec3 dp2 = dFdy(position);
        vec2 duv1 = dFdx(uv);
        vec2 duv2 = dFdy(uv);
        vec3 dp2perp = cross(dp2, normal);
        vec3 dp1perp = cross(normal, dp1);
        vec3 tangent = dp2perp * duv1.x + dp1perp * duv2.x;
        vec3 bitangent = dp2perp * duv1.y + dp1perp * duv2.y;
        float scale = inversesqrt(max(max(dot(tangent, tangent), dot(bitangent, bitangent)), 1e-12));
        vec2 slope = vec2(hx - h, hy - h) * strength * 3.0;
        return normalize(normal - (tangent * slope.x + bitangent * slope.y) * scale);
    }

    Info describe(int material, vec4 texel, vec3 tint, vec3 normal, vec3 position, vec3 world, vec2 uv, float ao, float sky, float block, bool terrain) {
        vec3 albedo = texel.rgb * tint;
        float smoothness = 0.08;
        float f0 = 0.04;
        float sss = 0.0;
        float emission = 0.0;
        float roughness = 0.6;
        float saturation = max(texel.r, max(texel.g, texel.b)) - min(texel.r, min(texel.g, texel.b));

        switch (material) {
            case LEAVES -> {
                sss = 0.75;
                smoothness = 0.25;
                roughness = 0.3;
            }
            case PLANTS, TALL_PLANTS, VINES, LILY -> {
                sss = 0.6;
                roughness = 0.2;
            }
            case GLASS -> {
                smoothness = 0.95;
                roughness = 0.0;
            }
            case METAL -> {
                smoothness = 0.6 + 0.25 * luminance(texel.rgb);
                f0 = 0.75;
                roughness = 0.4;
            }
            case POLISHED -> {
                smoothness = 0.55;
                roughness = 0.25;
            }
            case ORE -> {
                float gem = smoothstep(0.12, 0.32, saturation);
                smoothness = mix(0.1, 0.85, gem);
                f0 = mix(0.04, 0.3, gem);
                emission = gem * 0.12;
            }
            case ICE -> {
                smoothness = 0.9;
                f0 = 0.02;
                roughness = 0.1;
            }
            case SNOW -> {
                sss = 0.2;
                smoothness = 0.25;
                roughness = 0.25;
            }
            case GLOWING -> emission = smoothstep(0.45, 0.85, luminance(texel.rgb)) * 1.2;
            case LAVA -> emission = 1.0;
            case REDSTONE_WIRE -> emission = smoothstep(0.35, 1.0, tint.r) * luminance(texel.rgb) * 0.8;
            case REDSTONE_LIT -> emission = smoothstep(0.25, 0.5, texel.r - max(texel.g, texel.b)) * smoothstep(0.5, 0.8, texel.r) * 0.9;
            case MAGMA -> emission = smoothstep(0.35, 0.75, texel.r) * smoothstep(0.1, 0.35, texel.g) * 1.2;
            case SCULK -> emission = smoothstep(0.35, 0.65, texel.g) * smoothstep(0.35, 0.65, texel.b);
            case EMISSIVE_PARTS -> {
                sss = 0.6;
                roughness = 0.2;
                emission = block >= 0.99 ? 0.6 : 0.0;
            }
            default -> {
            }
        }

        float distance = length(position);
        float bumpsEnd = min(96.0, effectDistance);
        vec3 bumped = terrain ? bump(uv, position, normal, roughness * bumps * (1.0 - smoothstep(bumpsEnd * 0.25, bumpsEnd, distance))) : normal;
        float puddle = 0.0;

        if (terrain && wetness > 0.0 && material != WATER && material != LAVA && sss == 0.0 && material != GLASS) {
            float up = smoothstep(0.7, 0.95, normal.y);
            float open = smoothstep(0.85, 0.95, sky);
            float pattern = texture(noise, world.xz / 40.0).r * 0.65 + texture(noise, world.xz / 9.0).g * 0.35;
            puddle = smoothstep(0.5, 0.58, pattern + wetness * 0.22) * wetness * puddles * up * open;
            float damp = wetness * open * 0.5;
            albedo *= 1.0 - max(puddle * 0.25, damp * 0.35);
            smoothness = max(smoothness, max(puddle * 0.95, damp * 0.45));
            f0 = max(f0, 0.02);
            bumped = normalize(mix(bumped, normal, puddle));
        }

        float blockLight = material == EMISSIVE_PARTS && block >= 0.99 ? 0.0 : block;
        return new Info(albedo, bumped, smoothness, f0, sss, emission, ao, sky, blockLight, puddle);
    }

    Info withMaterial(Info info, vec3 normal, float smoothness, float f0) {
        return new Info(info.albedo, normal, smoothness, f0, info.sss, info.emission, info.ao, info.sky, info.block, info.puddle);
    }

    vec4 spriteAverage(vec2 uv) {
        vec2 size = vec2(textureSize(SOURCE, 0));
        vec2 texel = 1.0 / size;
        vec2 low = floor(uv * size / 16.0) * 16.0 * texel;
        vec3 color = vec3(0.0);
        float alpha = 0.0;

        for (int x = 0; x < 4; x++) {
            for (int y = 0; y < 4; y++) {
                vec4 sample = textureLod(SOURCE, low + (vec2(float(x), float(y)) * 4.0 + 1.5) * texel, 0.0);
                color += sample.rgb * sample.a;
                alpha += sample.a;
            }
        }

        return vec4(color / max(alpha, 0.001), alpha / 16.0);
    }
}
