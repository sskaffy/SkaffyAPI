package skaffy.vista;

import skaffy.shader.*;

public class Lighting {
    @Uniform float softness = 1.0;
    @Uniform float coloredMix = 1.0;

    vec2 vogel(int index, int count, float rotation) {
        float radius = sqrt((float(index) + 0.5) / float(count));
        float angle = float(index) * 2.39996 + rotation;
        return radius * vec2(cos(angle), sin(angle));
    }

    vec3 sunShadow(vec3 position, vec3 normal, float range, float dither) {
        if (dimension != OVERWORLD) {
            return vec3(1.0);
        }

        float distance = length(position);

        if (distance > range) {
            return vec3(1.0);
        }

        float facing = clamp(dot(normal, lightDirection), 0.0, 1.0);
        vec3 at = shadowPos(position + normal * (0.035 + distance * 0.0025) * (1.6 - facing));

        if (at.x <= 0.0 || at.x >= 1.0 || at.y <= 0.0 || at.y >= 1.0 || at.z >= 1.0) {
            return vec3(1.0);
        }

        float texel = 1.0 / float(textureSize(SHADOW_MAP, 0).x);
        float radius = texel * (1.0 + softness * 2.5);
        float lit = 0.0;
        float litSolid = 0.0;
        const int SAMPLES = 8;

        for (int i = 0; i < SAMPLES; i++) {
            vec2 offset = vogel(i, SAMPLES, dither * TAU) * radius;
            lit += texture(SHADOW_MAP, at.xy + offset).r >= at.z - 0.0002 ? 1.0 : 0.0;
            litSolid += texture(SHADOW_MAP_SOLID, at.xy + offset).r >= at.z - 0.0002 ? 1.0 : 0.0;
        }

        lit /= float(SAMPLES);
        litSolid /= float(SAMPLES);
        vec4 color = texture(SHADOW_COLOR, at.xy);
        vec3 through = mix(vec3(1.0), color.rgb * 2.0, color.a);
        vec3 light = vec3(lit) + max(litSolid - lit, 0.0) * through;
        return mix(light, vec3(1.0), smoothstep(range * 0.92, range, distance));
    }

    vec3 block(vec3 world, vec3 normal, float level) {
        vec3 vanilla = Palette.torchColor() * Palette.blockCurve(level);

        if (!inLightVolume(world)) {
            return vanilla;
        }

        vec3 at = world + normal * 0.5;
        float typed = lightLevel(at);
        vec3 shaped = vec3(0.0);

        if (typed > 0.0001) {
            shaped = coloredLight(at) / typed * Palette.blockCurve(min(typed, 1.0)) * 1.4 * Palette.torchlight;
        }

        vec3 rest = Palette.torchColor() * max(Palette.blockCurve(level) - Palette.blockCurve(min(typed + 1.0 / 15.0, 1.0)), 0.0);
        return mix(vanilla, shaped + rest, coloredMix);
    }

    vec3 held(vec3 position, vec3 normal) {
        if (heldLight <= 0.0) {
            return vec3(0.0);
        }

        float distance = length(position);
        float level = clamp(heldLight - distance / 15.0, 0.0, 1.0);
        float facing = max(dot(normal, -position / max(distance, 0.001)), 0.0) * 0.6 + 0.4;
        return heldLightColor * Palette.blockCurve(level) * 1.4 * Palette.torchlight * facing;
    }

    float specular(vec3 normal, vec3 view, vec3 light, float smoothness, float f0) {
        vec3 half = normalize(view + light);
        float roughness = max(1.0 - smoothness, 0.04);
        float a = roughness * roughness;
        float a2 = a * a;
        float nh = max(dot(normal, half), 0.0);
        float nl = max(dot(normal, light), 0.0);
        float nv = max(dot(normal, view), 0.001);
        float d = nh * nh * (a2 - 1.0) + 1.0;
        float distribution = a2 / (PI * d * d);
        float k = a * 0.5;
        float geometry = nl / (nl * (1.0 - k) + k) * nv / (nv * (1.0 - k) + k);
        float fresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(half, view), 0.0), 5.0);
        return min(distribution * geometry * fresnel / (4.0 * nv), 40.0);
    }

    vec3 light(Surface.Info surface, vec3 position, vec3 world, vec3 geometry, float range, float dither, bool hand) {
        vec3 view = -normalize(position);
        vec3 direct = vec3(0.0);
        vec3 ambient;
        vec3 shine = vec3(0.0);

        if (dimension == OVERWORLD) {
            vec3 toLight = lightDirection;
            vec3 facing = surface.sss > 0.0 && dot(geometry, toLight) < 0.0 ? -geometry : geometry;
            vec3 shadow = hand ? vec3(eyeSkyLight * eyeSkyLight) : sunShadow(position, facing, range, dither);

            if (!hand && length(position) > range) {
                shadow = vec3(smoothstep(0.8, 0.97, surface.sky));
            }

            shadow *= 1.0 - Clouds.shadow(world);

            float nDotL = dot(surface.normal, toLight);
            float diffuse = mix(max(nDotL, 0.0), 0.55 + 0.25 * abs(nDotL), surface.sss);
            float through = surface.sss * pow(max(dot(-view, toLight), 0.0), 6.0) * 1.4;
            vec3 sun = Palette.directLight();
            direct = sun * shadow * (diffuse + through);
            shine = sun * shadow * specular(surface.normal, view, toLight, surface.smoothness, surface.f0) * max(nDotL, 0.0);
            ambient = Palette.skyAmbient(surface.normal) * surface.sky * surface.sky;
        } else {
            ambient = Palette.dimensionAmbient();
        }

        vec3 blocks = block(world, surface.normal, surface.block) + held(position, surface.normal);
        vec3 diffuseLight = direct + (ambient + blocks + Palette.caveLight()) * mix(0.35, 1.0, surface.ao);
        vec3 metal = mix(vec3(1.0), surface.albedo, clamp((surface.f0 - 0.2) / 0.5, 0.0, 1.0));
        return surface.albedo * diffuseLight * (1.0 - clamp(surface.f0, 0.0, 0.6)) + shine * metal + surface.albedo * surface.emission * 4.0;
    }
}
